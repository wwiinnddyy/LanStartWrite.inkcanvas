<Window xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="LanStartWrite.Inkcanvas.ZoomSecondaryMenuWindow" Title="缩放" WindowStartupLocation="Manual"
 ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" WindowStyle="None"
 IsShowTitleBar="False" IsShowMinimizeButton="False" IsShowMaximizeButton="False" IsShowCloseButton="False" HasSystemMenu="False"
 AllowsTransparency="True" SystemBackdrop="None" Width="216" Height="44"
 Foreground="{StaticResource TextFillColorPrimaryBrush}">
  <!--
    缩放的二级菜单：**只有一条滑块 + 一个数字框**，浮在右下角那排缩放控件的<b>正上方</b>。

    三条都是被用户点掉之后定的，别再加回去：
      · <b>不要标题、不要说明、不要「适应窗口 / 原始大小」按钮</b> ——
        第一版是 264 宽还带一堆字和两颗钮，浮出来是一整块面板，挡图。
      · <b>只有滑块那么长</b>（216×44）—— 它是"临时拖一下"的东西，不是第二套设置页。
      · <b>必须有数字框</b>：滑块是无级的，而无级的东西不配一个数就没法"停到我要的那一档"。
        没有它，用户只能看着滑块猜自己到了百分之几。

    范围 0~300%：100% = 原始大小。IsSnapToTickEnabled=False 才叫无级 ——
    默认开启时值会被吸到 TickFrequency 上，而"吸上去"把一条连续的手势变成一串台阶。
  -->
  <Border x:Name="ZoomMenuSurface" Padding="10,8" CornerRadius="8" Background="{StaticResource FlyoutSurfaceBrush}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <!-- 数字框：跟着滑块走，宽度固定所以拖滑块时数字不会把滑块顶来顶去。 -->
      <TextBox x:Name="ZoomValueBox"
               Width="56"
               Margin="0,0,8,0"
               VerticalContentAlignment="Center"
               TextAlignment="Right"
               IsReadOnly="True"
               Text="100%" />
      <Slider x:Name="ZoomSlider"
              Width="132"
              VerticalAlignment="Center"
              Minimum="0" Maximum="300"
              TickFrequency="1"
              IsSnapToTickEnabled="False"
              SmallChange="1"
              LargeChange="25"
              Value="100"
              AutomationProperties.Name="缩放比例" />
    </StackPanel>
  </Border>
</Window>
