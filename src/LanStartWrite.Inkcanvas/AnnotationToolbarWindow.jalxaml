<Window xmlns="http://schemas.jalium.ui/2024"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanStartWrite.Inkcanvas"
        x:Class="LanStartWrite.Inkcanvas.AnnotationToolbarWindow"
        Title="揽星书写"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        IsShowTitleBar="False"
        AllowsTransparency="True"
        SystemBackdrop="None"
        Background="Transparent"
        Opacity="1"
        Left="120"
        Top="120"
        Width="300"
        Height="88">

    <!-- 浮动 CommandBar：透明宿主 + 高 56 圆角 8 白色实体（WinUI3 OverlayCornerRadius） -->
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Height="56"
                Margin="6"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                ClipToBounds="True"
                Padding="8,7">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <!--
                  RadioToolToggleButton 是 AppBarToggleButton 的派生类型，而隐式样式按精确类型查，
                  派生类型不保证命中 —— 所以这里显式点库的键名（FluentJalium 自己的派生控件也一律这么做）。
                -->
                <local:RadioToolToggleButton x:Name="MouseToolToggle"
                                             Style="{StaticResource DefaultAppBarToggleButtonStyle}"
                                             FocusVisualStyle="{StaticResource FocusVisualRingStyle}"
                                             IsCompact="True"
                                             Label="鼠标"
                                             Margin="2,0" />
                <local:RadioToolToggleButton x:Name="PenToolToggle"
                                             Style="{StaticResource DefaultAppBarToggleButtonStyle}"
                                             FocusVisualStyle="{StaticResource FocusVisualRingStyle}"
                                             IsCompact="True"
                                             Label="笔"
                                             Margin="2,0" />
                <local:RadioToolToggleButton x:Name="EraseToolToggle"
                                             Style="{StaticResource DefaultAppBarToggleButtonStyle}"
                                             FocusVisualStyle="{StaticResource FocusVisualRingStyle}"
                                             IsCompact="True"
                                             Label="橡皮"
                                             Margin="2,0" />

                <AppBarButton x:Name="UndoToolbarButton"
                              FocusVisualStyle="{StaticResource FocusVisualRingStyle}"
                              IsCompact="True"
                              Label="撤销"
                              Margin="2,0" />
                <AppBarButton x:Name="RedoToolbarButton"
                              FocusVisualStyle="{StaticResource FocusVisualRingStyle}"
                              IsCompact="True"
                              Label="重做"
                              Margin="2,0" />

                <Border Width="1"
                        Height="26"
                        Margin="{StaticResource AppBarSeparatorMargin}"
                        Background="{StaticResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

                <AppBarButton x:Name="SettingsToolbarButton"
                              FocusVisualStyle="{StaticResource FocusVisualRingStyle}"
                              IsCompact="True"
                              Label="设置"
                              Margin="2,0"
                              Click="SettingsToolbarButton_OnClick" />
            </StackPanel>
        </Border>

        <!--
          拖动把手直接由 Border 承担命中，不再在里面套 Button。
          Button 会在按下时先获取鼠标捕获，和 Window.DragMove 的原生拖窗流程冲突，
          表现为按住把手却无法移动窗口。
        -->
        <Border x:Name="DragHandleChrome"
                Grid.Column="1"
                Height="56"
                Width="40"
                Margin="6,6,6,6"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                VerticalAlignment="Top"
                IsHitTestVisible="True">
            <!-- 自绘双竖线，避免图标字体自身留白导致视觉中心偏移。 -->
            <Grid Width="8"
                  Height="16"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  IsHitTestVisible="False">
                <Border Width="1"
                        Height="16"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource TextFillColorPrimaryBrush}" />
                <Border Width="1"
                        Height="16"
                        Margin="0,0,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource TextFillColorPrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
