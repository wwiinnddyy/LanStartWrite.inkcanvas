<Window xmlns="http://schemas.jalium.ui/2024"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanStartWrite.Inkcanvas"
        x:Class="LanStartWrite.Inkcanvas.AnnotationToolbarWindow"
        Title="揽星书写"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        IsShowTitleBar="False"
        AllowsTransparency="True"
        SystemBackdrop="None"
        Background="Transparent"
        Opacity="1"
        Left="120"
        Top="120"
        Width="300"
        Height="88">

    <!--
      浮动 CommandBar：透明宿主 + 高 56 圆角 8 白色实体（WinUI3 OverlayCornerRadius）。
      上面的 Left/Top 只是兜底 —— 出现位置由 ToolbarPlacement 在 Show 之前算
      （主屏工作区下方居中、贴着任务栏上方一点），这里写不死，因为它取决于屏与按钮数。
    -->
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Height="56"
                Margin="6"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                ClipToBounds="True"
                Padding="8,7">
            <StackPanel x:Name="ToolsPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <!--
                  按钮不在这里声明：它们是数据驱动的（ToolbarTools 里的项，用户可以增删改序），
                  由 code-behind 按那份列表建出来塞进这个 StackPanel。
                  标记里留一个空容器而不是写死六颗钮 —— 写死的那一刻，"再来一支红笔"就无处安放了。
                  样式与图标的分工见 code-behind 的 BuildToolControl。
                -->
            </StackPanel>
        </Border>

        <!--
          拖动把手直接由 Border 承担命中，不再在里面套 Button。
          Button 会在按下时先获取鼠标捕获，和 Window.DragMove 的原生拖窗流程冲突，
          表现为按住把手却无法移动窗口。
        -->
        <Border x:Name="DragHandleChrome"
                Grid.Column="1"
                Height="56"
                Width="40"
                Margin="6,6,6,6"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{StaticResource ToolbarSurfaceBrush}"
                BorderBrush="{StaticResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                VerticalAlignment="Top"
                IsHitTestVisible="True">
            <!-- 自绘双竖线，避免图标字体自身留白导致视觉中心偏移。 -->
            <Grid Width="8"
                  Height="16"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  IsHitTestVisible="False">
                <Border Width="1"
                        Height="16"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource TextFillColorPrimaryBrush}" />
                <Border Width="1"
                        Height="16"
                        Margin="0,0,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{StaticResource TextFillColorPrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
