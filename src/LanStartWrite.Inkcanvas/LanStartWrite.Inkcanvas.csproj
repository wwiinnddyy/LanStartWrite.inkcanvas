<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 机器上若设置了环境变量 Version（如 Ice/构建链的 V7.xx），会污染 NuGet 还原；此处显式锁定合法 SemVer。 -->
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0-windows</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>

    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Debug'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jalium.UI" Version="26.10.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fluent(WinUI3) 主题字典：嵌入资源，启动时由 XamlReader 加载到应用资源 -->
    <EmbeddedResource Include="Themes\Fluent\*.jalxaml" LogicalName="Themes/Fluent/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Themes\Fluent\Controls\*.jalxaml" LogicalName="Themes/Fluent/Controls/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
