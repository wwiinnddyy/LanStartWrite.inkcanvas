<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 机器上若设置了环境变量 Version（如 Ice/构建链的 V7.xx），会污染 NuGet 还原；此处显式锁定合法 SemVer。 -->
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      双目标：net10.0-windows 是主目标（发布安装器）；net10.0 是给 Linux 打包（AppImage）用的。
      两端共用同一份源码 —— 应用不用 Windows 桌面框架（UI 全在 Jalium 上），
      所以 net10.0 这一端能编过；仅有的平台差异（Win32 的 Z 序 / 截屏互操作）在代码里按 OS 收口。
    -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <!-- 在 Linux 上还原 net10.0-windows 这一端需要它（要拉 WindowsDesktop 框架包）。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>

    <!--
      FluentJalium 是兄弟仓库（源码直引），路径因机器而异 —— 本机默认是 C:\git\Jalium\FluentJalium，
      CI 里用 -p:FluentJaliumProject=<签出路径> 指过去，不用改这份文件。
    -->
    <FluentJaliumProject Condition="'$(FluentJaliumProject)' == ''">..\..\..\..\Jalium\FluentJalium\src\FluentJalium\FluentJalium.csproj</FluentJaliumProject>

    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Debug'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jalium.UI" Version="26.10.9" />
    <!-- 闭源 SDK：单个混淆过的 Dusk.dll，来自 ../dusk-feed（见 NuGet.config）。 -->
    <PackageReference Include="Dusk" Version="1.0.3" />
    <!--
      PDF 光栅化：Chromium 的 PDFium，**只有原生二进制，没有托管绑定**
      （托管绑定在 PDFtoImage 里，而那一份会拖进 SkiaSharp）。

      这里按用户定的「直连、不引 Skia」走：P/Invoke 由 Pdf\PdfiumNative.cs 自己写。
      换来的代价是多写一个薄薄�� interop 层，换来的是
      渲染链上**不出现第二个图形栈**（本项目的渲染器是 Jalium 的 Vello/DX12）。

      只引两个平台包，**不引 bblanchon.PDFium 那个元包** —— 它会把 Android / iOS / macOS /
      WebAssembly 一并拉进来，而 deb 与 AppImage 的体积与依赖审计都不该为它们付账。
      nupkg 已 vendor 进 packaging/feed（守住 NuGet.config 的 <clear/>，CI 不用改）。
    -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8066" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="156.0.8066" />
    <!--
      Fluent 控件层：FluentJalium（Astra），源码直引。
      库自己只依赖 Jalium.UI.Controls + .Xaml（都是 TFM 无关的 net10.0 程序集），
      路径见上面的 FluentJaliumProject 属性。
      墨迹引擎 Dusk 才需要 feed 那套版本仪式（要混淆、要闭源），这里没有那个理由。
    -->
    <ProjectReference Include="$(FluentJaliumProject)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      应用自有主题：只有 FluentJalium 没有的东西 —— 实体浮层表面色、颜色色板。
      控件外观全部由 FluentThemeManager.Apply 装入的库字典提供，这里不再自带任何一份。
      嵌入资源、启动时由 FluentTheme 用 XamlReader 装载（与库自己的装载方式一致）。
    -->
    <EmbeddedResource Include="Themes\*.jalxaml" LogicalName="Themes/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
