<Window xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanStartWrite.Inkcanvas" xmlns:fluent="clr-namespace:FluentJalium.Controls;assembly=FluentJalium" x:Class="LanStartWrite.Inkcanvas.SettingsWindow" Title="设置" Width="960" Height="720" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True" AllowsTransparency="False" SystemBackdrop="None" Background="{StaticResource SolidBackgroundFillColorBaseBrush}" Foreground="{StaticResource TextFillColorPrimaryBrush}" UseLayoutRounding="True">
    <Grid x:Name="SettingsLayoutRoot" Background="{StaticResource SolidBackgroundFillColorBaseBrush}">
        <!--
          导航栏整体交给 FluentNavigationView：220/48 两态、汉堡键、跨条目的一条 3x16 选中指示条，
          以及"窄到 800 DIP 自动折叠"都是库里的实现（它自带 NavigationIndicatorAnimator）。
          Design.MD §6 早写着"若 NavigationView 稳定可用就优先迁过去"，这一步就是那笔账。
          Padding=0：内容区那一圈留白由本页 SettingsContentHost 自己按 640 DIP 断点收，不让它和库的默认 24 叠成 48。
        -->
        <fluent:FluentNavigationView x:Name="NavigationRoot" OpenPaneLength="220" Padding="0"
                                     Background="{StaticResource LayerFillColorDefaultBrush}">
            <fluent:FluentNavigationView.MenuItems>
                <fluent:FluentNavigationItem x:Name="AppearanceNavButton" Content="外观" ToolTip="外观">
                    <fluent:FluentNavigationItem.Icon><FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" /></fluent:FluentNavigationItem.Icon>
                </fluent:FluentNavigationItem>
                <fluent:FluentNavigationItem x:Name="InkNavButton" Content="墨迹" ToolTip="墨迹">
                    <fluent:FluentNavigationItem.Icon><FontIcon Glyph="&#xE76D;" FontFamily="Segoe Fluent Icons" /></fluent:FluentNavigationItem.Icon>
                </fluent:FluentNavigationItem>
                <fluent:FluentNavigationItem x:Name="InteractionNavButton" Content="窗口与交互" ToolTip="窗口与交互">
                    <fluent:FluentNavigationItem.Icon><FontIcon Glyph="&#xE7C9;" FontFamily="Segoe Fluent Icons" /></fluent:FluentNavigationItem.Icon>
                </fluent:FluentNavigationItem>
            </fluent:FluentNavigationView.MenuItems>
            <fluent:FluentNavigationView.FooterMenuItems>
                <fluent:FluentNavigationItem x:Name="AboutNavButton" Content="关于" ToolTip="关于">
                    <fluent:FluentNavigationItem.Icon><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" /></fluent:FluentNavigationItem.Icon>
                </fluent:FluentNavigationItem>
            </fluent:FluentNavigationView.FooterMenuItems>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="SettingsContentHost" Margin="24,24,24,24" HorizontalAlignment="Stretch" MaxWidth="960">
                            <StackPanel x:Name="AppearanceSectionPanel">
                                <TextBlock Text="外观" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="选择应用主题与动态效果。" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0" />
                                <TextBlock Text="主题与显示" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <fluent:FluentSettingsRow StackAtWidth="420" x:Name="ThemeSettingsRow">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="应用主题" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="同时应用于工具栏、笔菜单和设置窗口。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeComboBox" Width="144" VerticalAlignment="Center">
                                            <ComboBoxItem Content="浅色" />
                                            <ComboBoxItem Content="深色" />
                                            <ComboBoxItem Content="跟随系统" />
                                        </ComboBox>
                                    </fluent:FluentSettingsRow>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <fluent:FluentSettingsRow StackAtWidth="320">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="减少动画" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="关闭控件过渡和页面淡入；也尊重系统动画设置。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <fluent:FluentToggleSwitch x:Name="ReduceMotionSwitch" ToolTip="减少动画" VerticalAlignment="Center" />
                                    </fluent:FluentSettingsRow>
                                </Border>
                                <TextBlock Text="界面规范" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="WinUI 3 / Fluent Design" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="圆角、间距、字体层级、选中态与键盘焦点由 FluentJalium 统一提供。" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="浮动窗口采用不透明主题表面，保证在任意桌面背景上清晰可见。" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="InkSectionPanel">
                                <TextBlock Text="墨迹" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="配置画笔、压力与笔锋。" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0" />
                                <TextBlock Text="笔迹" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="画笔粗细" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock x:Name="PenWidthValueText" Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="与工具栏的笔设置保持同步。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        <Slider x:Name="PenWidthSlider" Margin="0,8,0,0" Minimum="1" Maximum="24" Value="4" TickFrequency="1" SmallChange="1" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <fluent:FluentSettingsRow StackAtWidth="320">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="压力感应" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="支持压感的笔可根据压力改变笔迹宽度。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <fluent:FluentToggleSwitch x:Name="PressureSwitch" ToolTip="压力感应" VerticalAlignment="Center" />
                                    </fluent:FluentSettingsRow>
                                </Border>
                                <TextBlock Text="笔锋" Style="{StaticResource SectionTextStyle}" />
                                <TextBlock Text="笔锋是对点数据的压力重分布，与渲染方式无关。它对荧光笔和激光笔不起作用 —— 那两种的几何是等宽的，不读压力。" Style="{StaticResource HelperTextStyle}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <fluent:FluentSettingsRow StackAtWidth="360">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="启用笔锋" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="关掉之后压力原样透传，不做任何塑形。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <fluent:FluentToggleSwitch x:Name="TipEnabledSwitch" ToolTip="启用笔锋" VerticalAlignment="Center" />
                                    </fluent:FluentSettingsRow>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="笔锋档位" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock x:Name="TipPresetDescriptionText" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        <ComboBox x:Name="TipPresetComboBox" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="ResetTipPresetButton" Content="恢复为所选档位" />
                                            <Button x:Name="SaveTipPresetButton" Content="存为我的笔锋" Margin="8,0,0,0" />
                                            <Button x:Name="DeleteTipPresetButton" Content="删除" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="试写" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="用鼠标或触控笔在下框里写几笔：上面任何一项参数改动都会立刻反映到它上面。这里写的字不进批注板，清空只影响这个试写区。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        <Border Margin="0,10,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource CardStrokeColorDefaultBrush}" Background="{StaticResource LayerFillColorDefaultBrush}" ClipToBounds="True">
                                            <Grid x:Name="TipPreviewHost" Height="140" />
                                        </Border>
                                        <Button x:Name="ClearTipPreviewButton" Content="清空试写" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="TipParameterSections" />
                                <Button x:Name="ResetInkButton" Content="重置书写参数" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="InteractionSectionPanel">
                                <TextBlock Text="窗口与交互" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="让工具栏适应你的操作方式。" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0" />
                                <TextBlock Text="窗口行为" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <fluent:FluentSettingsRow StackAtWidth="320">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="始终置顶工具栏" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="鼠标模式下也保持置顶；书写时始终在画布上方。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <fluent:FluentToggleSwitch x:Name="KeepToolbarOnTopSwitch" ToolTip="始终置顶工具栏" VerticalAlignment="Center" />
                                    </fluent:FluentSettingsRow>
                                </Border>
                                <TextBlock Text="操作方式" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="鼠标与触摸" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="按住右侧双竖线把手移动工具栏；触摸使用独立的触点捕获。" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="再次点击已选中的笔打开颜色、粗细与笔类型菜单。" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Text="键盘" Style="{StaticResource BodyTextBlockStyle}" Margin="0,16,0,0" />
                                        <TextBlock Text="Tab 切换控件，空格切换开关，方向键调整滑块，Esc 关闭笔菜单或返回鼠标模式。" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="AboutSectionPanel">
                                <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="应用信息与设计基线。" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0" />
                                <TextBlock Text="揽星书写" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LanStartWrite.Inkcanvas" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock x:Name="AboutVersionText" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="基于 Jalium.UI 的桌面批注工具。" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="设计与实现" Style="{StaticResource SectionTextStyle}" />
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="WinUI 3 设计语言，Jalium 原生控件" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="控件外观取自 FluentJalium（Astra）：依据 microsoft-ui-xaml 的资源与状态定义适配，保留 Jalium 的输入、布局和窗口模型。" Style="{StaticResource HelperTextStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="墨迹引擎是 Dusk。像素对齐按设备无关单位与当前显示缩放计算，不将静态截图视为交互验证。" Style="{StaticResource HelperTextStyle}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="SaveStatusText" Grid.Row="1" Margin="24,0,24,12" Style="{StaticResource HelperTextStyle}" />
                </Grid>
        </fluent:FluentNavigationView>
    </Grid>
</Window>
