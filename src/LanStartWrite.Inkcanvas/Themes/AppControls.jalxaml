<!--
  应用自有样式：只放 FluentJalium（Astra）没有的那几项，且一律 BasedOn 库的键往上加，
  不另起一套尺度。为什么这几项算"库没有"：

  - PenColorSwatchStyle    九色画笔色板是揽星书写自己的交互，WinUI 侧没有对应控件。
  - SettingsCardStyle      库的 CardBorderStyle 只画卡片，不带设置页的行距与最小行高。
  - HelperTextStyle / SectionTextStyle
      库按 WinUI 原样发布字号尺度（BaseTextBlockStyle 那一族），不替宿主决定"辅助文字该是什么颜色"；
      而 Design.MD §3 要的是页面标题 > 分组标题 > 条目名称 > 辅助说明四级，颜色与节奏得由应用钉一次。
-->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="PenColorSwatchStyle" TargetType="RadioButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <Border Name="SelectionRing" Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Name="Swatch" Width="22" Height="22" CornerRadius="11" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Name="SwatchFocus" Margin="0" BorderThickness="1" CornerRadius="4" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource ControlStrongStrokeColorDefaultBrush}" />
          </Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource AccentFillColorDefaultBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="SwatchFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Swatch" Property="Width" Value="20" />
            <Setter TargetName="Swatch" Property="Height" Value="20" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Swatch" Property="Opacity" Value="0.4" />
            <Setter TargetName="SwatchFocus" Property="Opacity" Value="0" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="MinHeight" Value="72" />
  </Style>

  <Style x:Key="HelperTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="SectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Margin" Value="0,24,0,8" />
  </Style>

  <!--
    图标工具钮（浮动批注栏那六颗）。库没有这一档：
    AppBarButton / AppBarToggleButton 是"图标 + 下方标签"的 68x64 命令条按钮，
    它的 compact 触发器只是把标签收起来，内层边框仍然留着 22 DIP 的标签带（实测
    AppBarButtonInnerBorderCompactMargin = 2,6,2,22），于是选中实底只盖到上面一块、
    整条又明显过长。批注栏要的是 40x40 图标居中、未选透明、选中整块铺 accent，
    对应的是 Button / ToggleButton 这一族，所以这里只在库的键上做四件事：
      1. 定 40x40 的方格并清掉内边距与 MinHeight（库给的是 32 高的文字按钮节奏）；
      2. 动作钮直接继承 SubtleButtonStyle（未选透明 / hover SubtleSecondary / pressed SubtleTertiary）；
      3. 切换钮继承 DefaultToggleButtonStyle 的交互与背景色阶，但前景由应用选中态统一回到
         TextFillColorPrimaryBrush，保证浅色黑、深色白，不因选中态变成另一种颜色；
      4. 再把切换钮未选那一半的色阶换成和动作钮同一条 Subtle 阶梯（库里 ToggleButton 的默认态是
         带边框的实体按钮底，放在一排透明图标钮旁边会突出来一块）。
    颜色全部引用主题 token；键盘焦点环由库的 ButtonLayoutStyle 带进来。
  -->
  <Style x:Key="ToolActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="ToolToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- 未选那一半换成 Subtle 阶梯；选中态的前景仍使用主题主文本色。 -->
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="False" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="False" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
      </MultiTrigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="True" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!--
    「工具栏按钮」列表里那一排小按钮（用这支 / 上移 / 下移 / 删除）。
    库没有这一档：它的默认按钮是 32 高的标准动作钮，一行里放四颗会把行撑得很高、
    与旁边两行小字不对齐。这里只在库的 Subtle 阶梯上把节奏收小，颜色一个都不新定义。
    收起节奏的收益不只是好看 —— 一屏能多放几项，而"按钮多了要能一眼看全"正是这个列表的用途。
  -->
  <Style x:Key="ToolRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</ResourceDictionary>
