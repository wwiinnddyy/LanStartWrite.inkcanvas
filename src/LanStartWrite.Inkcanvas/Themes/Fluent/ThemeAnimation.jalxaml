<!--
  Fluent (WinUI3) 动效 token。
  控件使用 Jalium TransitionProperty/TransitionDuration，页面使用 DoubleAnimation。
  推荐缓动是 Jalium 的适配，不声称与 WinUI Composition 曲线逐帧相等。
  FluentTheme.ApplyMotionPolicy 处理减少动画；Enter 处理页面淡入。
-->
<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Duration x:Key="ControlHoverDuration">0:0:0.083</Duration>
    <Duration x:Key="ControlPressDuration">0:0:0.083</Duration>
    <Duration x:Key="FlyoutEnterDuration">0:0:0.167</Duration>
    <Duration x:Key="FlyoutExitDuration">0:0:0.12</Duration>
    <Duration x:Key="PaneTransitionDuration">0:0:0.20</Duration>
    <Duration x:Key="ToggleSwitchTransitionDuration">0:0:0.167</Duration>

</ResourceDictionary>
