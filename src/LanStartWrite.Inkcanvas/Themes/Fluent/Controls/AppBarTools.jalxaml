<?xml version="1.0" encoding="utf-8"?>
<!--
  Fluent (WinUI3) AppBar 工具按钮样式。
  规范来源：
  microsoft-ui-xaml/controls/dev/CommonStyles/AppBarButton_themeresources.xaml
  microsoft-ui-xaml/controls/dev/CommonStyles/AppBarToggleButton_themeresources.xaml
  - compact 40x40、图标 16、圆角 = ControlCornerRadius(4)
  - Resting 透明 / PointerOver SubtleFillColorSecondary(#09000000)
    / Pressed SubtleFillColorTertiary(#06000000)
  - Checked = AccentFillColorDefault(#0078D4) 实底 + TextOnAccent 白图标
  - Checked hover/pressed 走 Accent 阶梯；背景 120ms Recommended 自动过渡
-->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanStartWrite.Inkcanvas">
  <!-- ============ 工具切换钮（RadioToolToggleButton：单选 AppBar 钮） ============ -->
  <Style TargetType="local:RadioToolToggleButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource AppBarButtonCornerRadius}" />
    <Setter Property="Background" Value="{StaticResource SubtleFillColorTransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="local:RadioToolToggleButton">
        <Grid Background="Transparent">
          <Border Name="Root" Shape="RoundedRectangle" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" TransitionProperty="Background" TransitionDuration="0:0:0.083" TransitionTimingFunction="Recommended">
            <ContentPresenter Name="IconPresenter" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" />
          </Border>
          <Border xmlns="http://schemas.jalium.ui/2024" Name="ToolFocus" Margin="1" BorderThickness="2" CornerRadius="4" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False">
            <Border BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource FocusStrokeColorInnerBrush}" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <!-- Unchecked 状态反馈 -->
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="False" />
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="False" />
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillColorTertiaryBrush}" />
          </MultiTrigger>
          <!-- Checked：强调色实底 -->
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentFillColorTertiaryBrush}" />
          </MultiTrigger>
          <!-- Disabled -->
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillColorDisabledBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextFillColorDisabledBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="ToolFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="ToolFocus" Property="Opacity" Value="0" />
          </Trigger>
          <MultiTrigger xmlns="http://schemas.jalium.ui/2024">
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsEnabled" Value="False" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentFillColorDisabledBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentFillColorDisabledBrush}" />
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- ============ 设置钮（普通 AppBarButton） ============ -->
  <Style TargetType="AppBarButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource AppBarButtonCornerRadius}" />
    <Setter Property="Background" Value="{StaticResource SubtleFillColorTransparentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="AppBarButton">
        <Grid Background="Transparent">
          <Border Name="Root" Shape="RoundedRectangle" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" TransitionProperty="Background" TransitionDuration="0:0:0.083" TransitionTimingFunction="Recommended">
            <ContentPresenter Name="IconPresenter" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" />
          </Border>
          <Border xmlns="http://schemas.jalium.ui/2024" Name="ToolFocus" Margin="1" BorderThickness="2" CornerRadius="4" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False">
            <Border BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource FocusStrokeColorInnerBrush}" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillColorTertiaryBrush}" />
          </MultiTrigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillColorDisabledBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextFillColorDisabledBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="ToolFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="ToolFocus" Property="Opacity" Value="0" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
</ResourceDictionary>