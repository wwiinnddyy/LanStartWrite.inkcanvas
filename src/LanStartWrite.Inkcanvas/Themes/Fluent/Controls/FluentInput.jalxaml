<?xml version="1.0" encoding="utf-8"?>
<!-- WinUI source: microsoft-ui-xaml 19e3bdc3c. Jalium adapter, not WPF XAML. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanStartWrite.Inkcanvas">
  <Style x:Key="FluentToggleSwitchStyle" TargetType="local:FluentToggleSwitch">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate TargetType="local:FluentToggleSwitch">
        <Grid Background="Transparent">
          <Grid Width="40" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Name="SwitchTrack" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource ControlStrongStrokeColorDefaultBrush}" Background="{StaticResource ControlAltFillColorSecondaryBrush}" TransitionProperty="Background" TransitionDuration="0:0:0.083" />
            <Grid Name="ThumbHost" Width="20" Height="20" HorizontalAlignment="Left" Margin="{TemplateBinding ThumbOffset}" TransitionProperty="Margin" TransitionDuration="0:0:0.167" TransitionTimingFunction="Recommended">
              <Border Name="Knob" Width="12" Height="12" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource TextFillColorSecondaryBrush}" TransitionProperty="Width, Height, Background" TransitionDuration="0:0:0.083" />
            </Grid>
          </Grid>
          <Border Name="SwitchFocus" BorderThickness="2" Margin="1" CornerRadius="4" Opacity="0" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Knob" Property="Width" Value="17" />
            <Setter TargetName="Knob" Property="Height" Value="14" />
          </Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentFillColorDefaultBrush}" />
            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent" />
            <Setter TargetName="Knob" Property="Background" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Knob" Property="Width" Value="14" />
            <Setter TargetName="Knob" Property="Height" Value="14" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="False" />
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource ControlAltFillColorTertiaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="False" />
              <Condition Property="IsPointerPressed" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource ControlAltFillColorQuarternaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsPointerPressed" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentFillColorTertiaryBrush}" />
          </MultiTrigger>
          <Trigger Property="IsPointerPressed" Value="True">
            <Setter TargetName="Knob" Property="Width" Value="17" />
            <Setter TargetName="Knob" Property="Height" Value="14" />
            <Setter TargetName="ThumbHost" Property="TransitionDuration" Value="0:0:0" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="SwitchFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource ControlAltFillColorDisabledBrush}" />
            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource ControlStrongStrokeColorDisabledBrush}" />
            <Setter TargetName="Knob" Property="Background" Value="{StaticResource TextFillColorDisabledBrush}" />
            <Setter TargetName="SwitchFocus" Property="Opacity" Value="0" />
            <Setter TargetName="Knob" Property="Width" Value="12" />
            <Setter TargetName="Knob" Property="Height" Value="12" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsEnabled" Value="False" />
            </MultiTrigger.Conditions>
            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentFillColorDisabledBrush}" />
            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent" />
            <Setter TargetName="Knob" Property="Background" Value="{StaticResource TextOnAccentFillColorDisabledBrush}" />
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style x:Key="FluentSliderStyle" TargetType="Slider">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Background" Value="{StaticResource ControlStrongFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentFillColorDefaultBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Slider">
        <Grid Background="Transparent" Margin="0">
          <Rectangle Name="PART_Track" Height="4" RadiusX="2" RadiusY="2" Margin="8,0" VerticalAlignment="Center" Fill="{TemplateBinding Background}" />
          <Rectangle Name="PART_SelectionRange" Height="4" RadiusX="2" RadiusY="2" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" />
          <Grid Name="PART_Thumb" Width="16" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Width="20" Height="20" Margin="-2,0" CornerRadius="10" Background="{StaticResource ControlSolidFillColorDefaultBrush}" BorderBrush="{StaticResource SliderThumbStrokeBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Name="ThumbFill" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" TransitionProperty="Width, Height, Fill" TransitionDuration="0:0:0.167" />
            </Border>
          </Grid>
          <Border Name="SliderFocus" Margin="0,2" BorderThickness="2" CornerRadius="4" Opacity="0" IsHitTestVisible="False" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="ThumbFill" Property="Width" Value="14" />
            <Setter TargetName="ThumbFill" Property="Height" Value="14" />
            <Setter TargetName="ThumbFill" Property="Fill" Value="{StaticResource AccentFillColorSecondaryBrush}" />
            <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{StaticResource AccentFillColorSecondaryBrush}" />
          </Trigger>
          <Trigger Property="IsMouseCaptured" Value="True">
            <Setter TargetName="ThumbFill" Property="Width" Value="10" />
            <Setter TargetName="ThumbFill" Property="Height" Value="10" />
            <Setter TargetName="ThumbFill" Property="Fill" Value="{StaticResource AccentFillColorTertiaryBrush}" />
            <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{StaticResource AccentFillColorTertiaryBrush}" />
          </Trigger>
          <Trigger Property="AreAnyTouchesCaptured" Value="True">
            <Setter TargetName="ThumbFill" Property="Width" Value="10" />
            <Setter TargetName="ThumbFill" Property="Height" Value="10" />
            <Setter TargetName="ThumbFill" Property="Fill" Value="{StaticResource AccentFillColorTertiaryBrush}" />
            <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{StaticResource AccentFillColorTertiaryBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="SliderFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="PART_Track" Property="Fill" Value="{StaticResource ControlStrongFillColorDisabledBrush}" />
            <Setter TargetName="PART_SelectionRange" Property="Fill" Value="{StaticResource AccentFillColorDisabledBrush}" />
            <Setter TargetName="ThumbFill" Property="Fill" Value="{StaticResource AccentFillColorDisabledBrush}" />
            <Setter TargetName="SliderFocus" Property="Opacity" Value="0" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style TargetType="Slider" BasedOn="{StaticResource FluentSliderStyle}" />
  <Style x:Key="FluentRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Name="RadioRing" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Center" BorderThickness="1" Background="{StaticResource ControlAltFillColorSecondaryBrush}" BorderBrush="{StaticResource ControlStrongStrokeColorDefaultBrush}">
            <Ellipse Name="RadioDot" Width="12" Height="12" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource TextOnAccentFillColorPrimaryBrush}" TransitionProperty="Width, Height" TransitionDuration="0:0:0.167" />
          </Border>
          <ContentPresenter Grid.Column="1" Margin="8,0,0,0" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
          <Border Name="RadioFocus" Grid.ColumnSpan="2" Margin="-2,1" BorderThickness="2" CornerRadius="4" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource AccentFillColorDefaultBrush}" />
            <Setter TargetName="RadioRing" Property="BorderBrush" Value="Transparent" />
            <Setter TargetName="RadioDot" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="RadioDot" Property="Width" Value="14" />
            <Setter TargetName="RadioDot" Property="Height" Value="14" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="RadioDot" Property="Width" Value="10" />
            <Setter TargetName="RadioDot" Property="Height" Value="10" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="False" />
              <Condition Property="IsMouseOver" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource ControlAltFillColorTertiaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="False" />
              <Condition Property="IsPressed" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource ControlAltFillColorQuarternaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsMouseOver" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource AccentFillColorSecondaryBrush}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsPressed" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource AccentFillColorTertiaryBrush}" />
          </MultiTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="RadioFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource TextFillColorDisabledBrush}" />
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource ControlAltFillColorDisabledBrush}" />
            <Setter TargetName="RadioRing" Property="BorderBrush" Value="{StaticResource ControlStrongStrokeColorDisabledBrush}" />
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsChecked" Value="True" />
              <Condition Property="IsEnabled" Value="False" />
            </MultiTrigger.Conditions>
            <Setter TargetName="RadioRing" Property="Background" Value="{StaticResource AccentFillColorDisabledBrush}" />
            <Setter TargetName="RadioDot" Property="Fill" Value="{StaticResource TextOnAccentFillColorDisabledBrush}" />
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource FluentRadioButtonStyle}" />
  <Style x:Key="FluentComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource ComboBoxPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border Name="PART_MainBorder" TransitionProperty="BorderBrush, Background" TransitionDuration="0:0:0.12" TransitionTimingFunction="Recommended" Shape="RoundedRectangle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <ContentPresenter Name="PART_SelectionPresenter" Content="{Binding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      <Setter Property="TextWrapping" Value="NoWrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Grid>
              <Grid Name="PART_DropDownArea" Grid.Column="1" Background="Transparent">
                <ToggleButton Name="PART_ToggleButton" Margin="1,0,0,0" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{TemplateBinding IsDropDownOpen}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" Focusable="False">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Name="ToggleSurface" Shape="RoundedRectangle" CornerRadius="4" Background="Transparent">
                        <Path Name="FluentDropDownChevron" Data="M 1,2 L 5,6 L 9,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25" Width="10" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </Grid>
            </Grid>
          </Border>
          <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}}">
            <Grid Name="PART_PopupBorder" Margin="0,6,0,0">
              <Rectangle Fill="{StaticResource FlyoutPresenterBackgroundBrush}" Stroke="{StaticResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" RadiusX="8" RadiusY="8" />
              <ScrollViewer Margin="4" MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter />
              </ScrollViewer>
            </Grid>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{StaticResource ControlStrokeColorSecondaryBrush}" />
            <Setter TargetName="PART_MainBorder" Property="Background" Value="{StaticResource ControlFillColorSecondaryBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{StaticResource AccentFillColorDefaultBrush}" />
          </Trigger>
          <Trigger Property="IsDropDownOpen" Value="True">
            <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{StaticResource AccentFillColorDefaultBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="PART_MainBorder" Property="Background" Value="{StaticResource ControlFillColorTransparentBrush}" />
            <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{StaticResource ControlStrongStrokeColorDisabledBrush}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource TextFillColorDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- ============================ ComboBoxItem ============================ -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
    <Setter Property="Padding" Value="11,7,11,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ComboBoxItem">
        <Grid>
          <Border Name="PART_BackgroundBorder" Shape="RoundedRectangle" CornerRadius="{StaticResource MenuFlyoutItemCornerRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" />
          </Border>
          <Border xmlns="http://schemas.jalium.ui/2024" Name="ComboSelectionIndicator" Width="3" Height="16" CornerRadius="2" Margin="2,0,0,0" Background="{StaticResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{StaticResource SubtleFillColorSecondaryBrush}" />
          </Trigger>
          <Trigger Property="IsHighlighted" Value="True">
            <Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{StaticResource SubtleFillColorSecondaryBrush}" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="PART_BackgroundBorder" Property="Background" Value="{StaticResource SubtleFillColorSecondaryBrush}" />
            <Setter TargetName="ComboSelectionIndicator" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource TextFillColorDisabledBrush}" />
            <Setter TargetName="ComboSelectionIndicator" Property="Background" Value="{StaticResource AccentFillColorDisabledBrush}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBoxStyle}" />
  <Style x:Key="FluentColorSwatchStyle" TargetType="RadioButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <Border Name="SelectionRing" Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Name="Swatch" Width="22" Height="22" CornerRadius="11" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border xmlns="http://schemas.jalium.ui/2024" Name="SwatchFocus" Margin="0" BorderThickness="1" CornerRadius="4" BorderBrush="{StaticResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource ControlStrongStrokeColorDefaultBrush}" />
          </Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource AccentFillColorDefaultBrush}" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="SwatchFocus" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Swatch" Property="Width" Value="20" />
            <Setter TargetName="Swatch" Property="Height" Value="20" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Swatch" Property="Opacity" Value="0.4" />
            <Setter TargetName="SwatchFocus" Property="Opacity" Value="0" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>
</ResourceDictionary>