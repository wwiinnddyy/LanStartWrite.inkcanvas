<!--
  Fluent (WinUI3) 几何 token。
  来源：microsoft-ui-xaml CornerRadius_themeresources.xaml、
  CommonStyles/*_themeresources.xaml、NavigationView_themeresources.xaml。

  注意：Jalium 运行时 XamlReader 不支持 x:Double 资源，故尺寸数值
  （按钮 40、图标 16、轨道 4、指示条 3x16 等）以字面量统一写入各控件
  样式字典。以下为本应用采用的几何规格，单位为 DIP：

  AppBar：compact 按钮 40x40、图标 16、CommandBar 高 56、圆角 4
  ToggleSwitch：轨道 40x20 r10、Knob 12 / hover 14 / pressed 17x14、位移 20；命中区 48x32
  Slider：轨道高 4、外圈 20、内圆 12 / hover 14 / pressed 10；保留 Jalium 的 16px 布局锚点
  RadioButton：外圈 20、内点 12 / hover 14 / pressed 10、内容左距 8
  ComboBox：高 32、圆角 4、弹出层圆角 8
  MenuFlyout：Presenter 圆角 8、项圆角 4
  NavigationView：本应用展开宽 220 / 紧凑 48、项高 36、指示条 3x16 r2、汉堡 40x36
  通用间距梯度：4 / 8 / 12 / 16 / 24；设置卡行内部 Margin 16,12
-->
<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 形状 -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AppBarButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NavigationViewItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ComboBoxPopupCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MenuFlyoutItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NavigationViewSelectionIndicatorCornerRadius">2</CornerRadius>

    <!-- Margin / Padding -->
    <Thickness x:Key="CommandBarSeparatorMargin">12,0</Thickness>
    <Thickness x:Key="ToggleSwitchOnThumbMargin">20,0,0,0</Thickness>
    <Thickness x:Key="RadioButtonContentMargin">8,0,0,0</Thickness>
    <Thickness x:Key="ComboBoxPadding">11,5,11,6</Thickness>
    <Thickness x:Key="FlyoutPresenterPadding">0,2</Thickness>
    <Thickness x:Key="MenuFlyoutItemPadding">11,8,11,9</Thickness>
    <Thickness x:Key="NavigationViewItemContainerMargin">12,0,12,0</Thickness>
    <Thickness x:Key="NavigationViewItemButtonMargin">4,2</Thickness>
    <Thickness x:Key="NavigationViewPanePadding">8,16,12,16</Thickness>
    <Thickness x:Key="CardRowPadding">16,12</Thickness>

</ResourceDictionary>
