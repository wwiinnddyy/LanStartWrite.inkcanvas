<Window xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="LanStartWrite.Inkcanvas.PenSecondaryMenuWindow" Title="笔设置" WindowStartupLocation="Manual"
 ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" WindowStyle="None"
 IsShowTitleBar="False" IsShowMinimizeButton="False" IsShowMaximizeButton="False" IsShowCloseButton="False" HasSystemMenu="False"
  AllowsTransparency="True" SystemBackdrop="None" Foreground="{StaticResource TextFillColorPrimaryBrush}">
  <Border x:Name="PenMenuSurface" Padding="16" CornerRadius="8" Background="{StaticResource FlyoutSurfaceBrush}">

    <StackPanel>
      <TextBlock Text="画笔" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <Grid Margin="0,12,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="16" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
        <Grid Width="108" Height="108">
          <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
          <RadioButton x:Name="PenColorRing1" Grid.Row="0" Grid.Column="0" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing2" Grid.Row="0" Grid.Column="1" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing3" Grid.Row="0" Grid.Column="2" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing4" Grid.Row="1" Grid.Column="0" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing5" Grid.Row="1" Grid.Column="1" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing6" Grid.Row="1" Grid.Column="2" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing7" Grid.Row="2" Grid.Column="0" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing8" Grid.Row="2" Grid.Column="1" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" /><RadioButton x:Name="PenColorRing9" Grid.Row="2" Grid.Column="2" GroupName="PenColor" Style="{StaticResource PenColorSwatchStyle}" />
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <RadioButton x:Name="PenKindPenRadio" GroupName="PenKind" Content="书写笔" Margin="0,2" />
          <RadioButton x:Name="PenKindHighlighterRadio" GroupName="PenKind" Content="荧光笔" Margin="0,2" />
          <RadioButton x:Name="PenKindLaserRadio" GroupName="PenKind" Content="激光笔" Margin="0,2" />
        </StackPanel>
      </Grid>
      <Border Height="1" Background="{StaticResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,12" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="粗细" Style="{StaticResource BodyTextBlockStyle}"  />
        <TextBlock x:Name="PenThicknessValueText" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
      </Grid>
      <Slider x:Name="PenThicknessSlider" Width="236" Margin="0,4,0,0" Minimum="1" Maximum="24" Value="4" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" />
      <Border Height="1" Background="{StaticResource DividerStrokeColorDefaultBrush}" Margin="0,12,0,12" />
      <TextBlock Text="笔锋" Style="{StaticResource BodyTextBlockStyle}" />
      <TextBlock x:Name="PenTipHintText" Text="起笔与收笔的形状。" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" />
      <ComboBox x:Name="PenTipPresetComboBox" Width="236" Margin="0,6,0,0" />
    </StackPanel>
  </Border>
</Window>
