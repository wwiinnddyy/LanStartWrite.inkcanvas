<Window xmlns="http://schemas.jalium.ui/2024"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LanStartWrite.Inkcanvas.AnnotationOverlayWindow"
        Title=""
        WindowState="Maximized"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        IsShowTitleBar="False"
        IsShowMinimizeButton="False"
        IsShowMaximizeButton="False"
        IsShowCloseButton="False"
        HasSystemMenu="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        SystemBackdrop="None"
        ResizeMode="NoResize">
    <!-- 墨迹面不在标记里声明：由 code-behind new 出来塞进这个格子。 -->
    <Grid x:Name="InkHost"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"/>
</Window>
