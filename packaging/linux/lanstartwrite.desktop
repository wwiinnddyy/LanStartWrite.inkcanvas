[Desktop Entry]
Type=Application
Name=揽星书写
Comment=全屏批注与书写工具
# AppImage 真正的入口是 AppRun（见 build-appimage.sh），这份 .desktop 管的是系统集成
# （菜单项与图标）：Icon 必须与 AppDir 里的 <appid>.png 同名，appid 由文件名给出。
Exec=lanstartwrite
Icon=lanstartwrite
Terminal=false
Categories=Graphics;Office;
StartupNotify=true
StartupWMClass=LanStartWrite.Inkcanvas
