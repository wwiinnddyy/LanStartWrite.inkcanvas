[Desktop Entry]
Type=Application
Name=揽星书写
Comment=全屏批注与书写工具
# 三个格式（deb / Flatpak / 玲珑）共用这一份。文件名与 Icon= 都是反 DNS 的 APPID，
# 各处按 <appid>.desktop / <appid>.png 落位，谁也不改写它 —— 一改就会出现
# "菜单里是默认图" 或 "装了三个各带一张图的同名应用"。
# Exec 用短名：deb 落在 /usr/bin、Flatpak 落在 /app/bin、AppImage 由 AppRun 接住。
Exec=lanstartwrite
Icon=io.github.wwiinnddyy.lanstartwrite
Terminal=false
Categories=Graphics;Office;
# 文件关联。`application/pdf` 让"用本应用打开 PDF"出现在桌面的右键菜单里；
# 注册项是程序自己带的那份（deb 装到 /usr/share/applications、AppImage 自带、
# 玲珑模板照抄），所以这一行是**唯一**一处声明，三种包不会各说各的。
# 图像那几个 MIME **刻意不加**：图片走的是应用内"打开图片"入口，
# 而把它注册成系统默认会抢走别的看图软件的活 —— 那不是本应用该做的事。
MimeType=application/pdf;
StartupNotify=true
StartupWMClass=LanStartWrite.Inkcanvas
