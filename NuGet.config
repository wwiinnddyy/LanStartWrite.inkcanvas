<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      墨迹引擎 Dusk 以闭源 SDK 形式引入：包由 ../Dusk/sdk/build-sdk.ps1 产出并投放到 ../dusk-feed。
      这里只加源、不 <clear/>，免得把机器上的全局源（企业 feed 等）顶掉。
      同版本禁覆盖：feed 里已存在同版本时 build-sdk.ps1 会直接失败，
      因为 NuGet 全局包缓存不会因重装同名同版本而刷新。

      packaging/feed 是**随仓库走的一份拷贝**：CI（以及任何新克隆）没有 ../dusk-feed 这个本机路径，
      没有它构建就没法还原。本机优先走 ../dusk-feed（排在前面），随仓库的这份只在它缺席时兜底；
      Dusk 升版本时要记得把 packaging/feed 里的包一起换掉。
    -->
    <add key="dusk-sdk" value="../dusk-feed" />
    <add key="dusk-sdk-vendored" value="packaging/feed" />
  </packageSources>
</configuration>
